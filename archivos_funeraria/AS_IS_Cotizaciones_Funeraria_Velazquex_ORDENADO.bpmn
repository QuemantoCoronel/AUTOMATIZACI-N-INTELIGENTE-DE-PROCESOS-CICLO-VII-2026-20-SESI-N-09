<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ASIS_Cotizaciones" targetNamespace="http://bpmn.io/schema/bpmn" exporter="OpenAI" exporterVersion="1.0">
  <bpmn:message id="Message_Solicitud" name="Solicitud de cotización"/>
  <bpmn:message id="Message_SolicitudDatos" name="Solicitud de datos faltantes"/>
  <bpmn:message id="Message_DatosAdicionales" name="Datos adicionales"/>
  <bpmn:message id="Message_Cotizacion" name="Cotización"/>
  <bpmn:message id="Message_Aceptacion" name="Aceptación de cotización"/>
  <bpmn:message id="Message_Modificacion" name="Solicitud de modificación"/>
  <bpmn:message id="Message_Rechazo" name="Rechazo de cotización"/>
  <bpmn:dataStore id="DataStore_RegistroManual" name="Cuaderno / hoja de control de solicitudes"/>
  <bpmn:collaboration id="Collaboration_ASIS">
    <bpmn:participant id="Participant_Cliente" name="Cliente / familiar"/>
    <bpmn:participant id="Participant_Funeraria" name="Funeraria - Atención de cotizaciones" processRef="Process_Funeraria"/>
    <bpmn:messageFlow id="MessageFlow_Solicitud" name="Solicitud de cotización" sourceRef="Participant_Cliente" targetRef="StartEvent_Solicitud"/>
    <bpmn:messageFlow id="MessageFlow_SolicitarDatos" name="Solicitud de datos faltantes" sourceRef="Task_SolicitarDatos" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MessageFlow_Datos" name="Datos adicionales" sourceRef="Participant_Cliente" targetRef="Event_DatosRecibidos"/>
    <bpmn:messageFlow id="MessageFlow_Cotizacion" name="Cotización" sourceRef="Task_ComunicarCotizacion" targetRef="Participant_Cliente"/>
    <bpmn:messageFlow id="MessageFlow_Aceptacion" name="Aceptación" sourceRef="Participant_Cliente" targetRef="Event_Aceptacion"/>
    <bpmn:messageFlow id="MessageFlow_Modificacion" name="Modificación" sourceRef="Participant_Cliente" targetRef="Event_Modificacion"/>
    <bpmn:messageFlow id="MessageFlow_Rechazo" name="Rechazo" sourceRef="Participant_Cliente" targetRef="Event_Rechazo"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Funeraria" name="Atender y registrar solicitudes de cotización de servicios funerarios" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Funeraria">
      <bpmn:lane id="Lane_Atencion" name="Atención al cliente">
        <bpmn:flowNodeRef>StartEvent_Solicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecopilarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DatosSuficientes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SolicitarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EsperaDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_DatosRecibidos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualizarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimeoutDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Incompleta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentificarServicios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ComunicarCotizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarCotizacionEmitida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EsperaRespuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Aceptacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarAceptacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Modificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarModificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActualizarRequerimientos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Rechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarRechazo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TimeoutRespuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegistrarSinRespuesta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchivarSolicitud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cierre</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Administracion" name="Administración">
        <bpmn:flowNodeRef>Task_ConsultarTarifario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RevisarDisponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Disponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DefinirAlternativa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_MergeDisponibilidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcularImporte</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ElaborarCotizacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerificarCotizacion</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Solicitud" name="Solicitud de cotización recibida">
      <bpmn:messageEventDefinition id="MessageDef_Start" messageRef="Message_Solicitud"/>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_RegistrarSolicitud" name="Registrar solicitud en cuaderno u hoja de control"/>
    <bpmn:manualTask id="Task_RecopilarDatos" name="Recopilar datos del solicitante y del servicio"/>
    <bpmn:exclusiveGateway id="Gateway_DatosSuficientes" name="¿Información suficiente para cotizar?" gatewayDirection="Diverging"/>
    <bpmn:manualTask id="Task_SolicitarDatos" name="Solicitar datos faltantes al cliente"/>
    <bpmn:eventBasedGateway id="Gateway_EsperaDatos" name="Esperar datos del cliente" gatewayDirection="Diverging"/>
    <bpmn:intermediateCatchEvent id="Event_DatosRecibidos" name="Datos adicionales recibidos">
      <bpmn:messageEventDefinition id="MessageDef_Event_DatosRecibidos" messageRef="Message_DatosAdicionales"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_ActualizarDatos" name="Actualizar datos de la solicitud"/>
    <bpmn:intermediateCatchEvent id="Event_TimeoutDatos" name="Plazo sin recibir datos">
      <bpmn:timerEventDefinition id="TimerDef_Event_TimeoutDatos"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_RegistrarPendiente" name="Registrar solicitud incompleta o pendiente"/>
    <bpmn:endEvent id="EndEvent_Incompleta" name="Solicitud cerrada sin cotización"/>
    <bpmn:manualTask id="Task_IdentificarServicios" name="Identificar servicios funerarios requeridos"/>
    <bpmn:manualTask id="Task_ConsultarTarifario" name="Consultar tarifario impreso vigente"/>
    <bpmn:manualTask id="Task_RevisarDisponibilidad" name="Revisar disponibilidad en agenda o cuaderno"/>
    <bpmn:exclusiveGateway id="Gateway_Disponibilidad" name="¿Servicios disponibles?" gatewayDirection="Diverging"/>
    <bpmn:manualTask id="Task_DefinirAlternativa" name="Definir alternativa disponible"/>
    <bpmn:exclusiveGateway id="Gateway_MergeDisponibilidad" name="Continuar con propuesta" gatewayDirection="Converging"/>
    <bpmn:manualTask id="Task_CalcularImporte" name="Calcular importe de la propuesta"/>
    <bpmn:manualTask id="Task_ElaborarCotizacion" name="Elaborar cotización manual"/>
    <bpmn:manualTask id="Task_VerificarCotizacion" name="Verificar datos y monto de la cotización"/>
    <bpmn:manualTask id="Task_ComunicarCotizacion" name="Comunicar cotización al cliente"/>
    <bpmn:manualTask id="Task_RegistrarCotizacionEmitida" name="Registrar cotización emitida"/>
    <bpmn:eventBasedGateway id="Gateway_EsperaRespuesta" name="Esperar decisión del cliente" gatewayDirection="Diverging"/>
    <bpmn:intermediateCatchEvent id="Event_Aceptacion" name="Aceptación recibida">
      <bpmn:messageEventDefinition id="MessageDef_Event_Aceptacion" messageRef="Message_Aceptacion"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_RegistrarAceptacion" name="Registrar aceptación de la cotización"/>
    <bpmn:intermediateCatchEvent id="Event_Modificacion" name="Solicitud de modificación recibida">
      <bpmn:messageEventDefinition id="MessageDef_Event_Modificacion" messageRef="Message_Modificacion"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_RegistrarModificacion" name="Registrar modificación solicitada"/>
    <bpmn:manualTask id="Task_ActualizarRequerimientos" name="Actualizar requerimientos del cliente"/>
    <bpmn:intermediateCatchEvent id="Event_Rechazo" name="Rechazo recibido">
      <bpmn:messageEventDefinition id="MessageDef_Event_Rechazo" messageRef="Message_Rechazo"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_RegistrarRechazo" name="Registrar rechazo y motivo"/>
    <bpmn:intermediateCatchEvent id="Event_TimeoutRespuesta" name="Plazo de seguimiento vencido">
      <bpmn:timerEventDefinition id="TimerDef_Event_TimeoutRespuesta"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_RegistrarSinRespuesta" name="Registrar cotización sin respuesta"/>
    <bpmn:exclusiveGateway id="Gateway_MergeCierre" name="Consolidar cierre" gatewayDirection="Converging"/>
    <bpmn:manualTask id="Task_ArchivarSolicitud" name="Archivar solicitud y copia de la cotización"/>
    <bpmn:endEvent id="EndEvent_Cierre" name="Gestión de cotización finalizada"/>
    <bpmn:dataObject id="DataObject_Tarifario"/>
    <bpmn:dataObjectReference id="DataObjectRef_Tarifario" dataObjectRef="DataObject_Tarifario" name="Tarifario impreso"/>
    <bpmn:dataObject id="DataObject_Agenda"/>
    <bpmn:dataObjectReference id="DataObjectRef_Agenda" dataObjectRef="DataObject_Agenda" name="Agenda / cuaderno de disponibilidad"/>
    <bpmn:dataObject id="DataObject_Cotizacion"/>
    <bpmn:dataObjectReference id="DataObjectRef_Cotizacion" dataObjectRef="DataObject_Cotizacion" name="Cotización manual"/>
    <bpmn:dataStoreReference id="DataStoreRef_RegistroManual" dataStoreRef="DataStore_RegistroManual" name="Registro manual de solicitudes"/>
    <bpmn:textAnnotation id="TextAnnotation_Canales">
      <bpmn:text>Canales actuales: presencial, teléfono o WhatsApp. La información se transcribe y registra manualmente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Alcance">
      <bpmn:text>Fuera de alcance AS-IS: contratación, pago, retiro del cuerpo, velatorio, sepelio y cierre del servicio funerario.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Plazos">
      <bpmn:text>Los plazos de espera deben validarse con el personal de la funeraria antes de fijar horas o días concretos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Solicitud" targetRef="Task_RegistrarSolicitud"/>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_RegistrarSolicitud" targetRef="Task_RecopilarDatos"/>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_RecopilarDatos" targetRef="Gateway_DatosSuficientes"/>
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_DatosSuficientes" targetRef="Task_IdentificarServicios" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_DatosSuficientes" targetRef="Task_SolicitarDatos" name="No"/>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Task_SolicitarDatos" targetRef="Gateway_EsperaDatos"/>
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_EsperaDatos" targetRef="Event_DatosRecibidos" name="Datos recibidos"/>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_EsperaDatos" targetRef="Event_TimeoutDatos" name="Sin respuesta"/>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Event_DatosRecibidos" targetRef="Task_ActualizarDatos"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ActualizarDatos" targetRef="Gateway_DatosSuficientes"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Event_TimeoutDatos" targetRef="Task_RegistrarPendiente"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_RegistrarPendiente" targetRef="EndEvent_Incompleta"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_IdentificarServicios" targetRef="Task_ConsultarTarifario"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_ConsultarTarifario" targetRef="Task_RevisarDisponibilidad"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RevisarDisponibilidad" targetRef="Gateway_Disponibilidad"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_Disponibilidad" targetRef="Gateway_MergeDisponibilidad" name="Sí"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_Disponibilidad" targetRef="Task_DefinirAlternativa" name="No"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_DefinirAlternativa" targetRef="Gateway_MergeDisponibilidad"/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_MergeDisponibilidad" targetRef="Task_CalcularImporte"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_CalcularImporte" targetRef="Task_ElaborarCotizacion"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ElaborarCotizacion" targetRef="Task_VerificarCotizacion"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Task_VerificarCotizacion" targetRef="Task_ComunicarCotizacion"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_ComunicarCotizacion" targetRef="Task_RegistrarCotizacionEmitida"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_RegistrarCotizacionEmitida" targetRef="Gateway_EsperaRespuesta"/>
    <bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_EsperaRespuesta" targetRef="Event_Aceptacion" name="Acepta"/>
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Gateway_EsperaRespuesta" targetRef="Event_Modificacion" name="Solicita modificación"/>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Gateway_EsperaRespuesta" targetRef="Event_Rechazo" name="Rechaza"/>
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Gateway_EsperaRespuesta" targetRef="Event_TimeoutRespuesta" name="Sin respuesta"/>
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Event_Aceptacion" targetRef="Task_RegistrarAceptacion"/>
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Task_RegistrarAceptacion" targetRef="Gateway_MergeCierre"/>
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Event_Modificacion" targetRef="Task_RegistrarModificacion"/>
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_RegistrarModificacion" targetRef="Task_ActualizarRequerimientos"/>
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_ActualizarRequerimientos" targetRef="Task_IdentificarServicios" name="Reelaborar cotización"/>
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Event_Rechazo" targetRef="Task_RegistrarRechazo"/>
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_RegistrarRechazo" targetRef="Gateway_MergeCierre"/>
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Event_TimeoutRespuesta" targetRef="Task_RegistrarSinRespuesta"/>
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_RegistrarSinRespuesta" targetRef="Gateway_MergeCierre"/>
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_MergeCierre" targetRef="Task_ArchivarSolicitud"/>
    <bpmn:sequenceFlow id="Flow_39" sourceRef="Task_ArchivarSolicitud" targetRef="EndEvent_Cierre"/>
    <bpmn:association id="Association_Canales" sourceRef="TextAnnotation_Canales" targetRef="Task_RegistrarSolicitud" associationDirection="None"/>
    <bpmn:association id="Association_Alcance" sourceRef="TextAnnotation_Alcance" targetRef="Task_ComunicarCotizacion" associationDirection="None"/>
    <bpmn:association id="Association_Plazos" sourceRef="TextAnnotation_Plazos" targetRef="Gateway_EsperaRespuesta" associationDirection="None"/>
    <bpmn:association id="Association_RegistroSolicitud" sourceRef="Task_RegistrarSolicitud" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
    <bpmn:association id="Association_ActualizarDatos" sourceRef="Task_ActualizarDatos" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
    <bpmn:association id="Association_Tarifario" sourceRef="DataObjectRef_Tarifario" targetRef="Task_ConsultarTarifario" associationDirection="One"/>
    <bpmn:association id="Association_Agenda" sourceRef="DataObjectRef_Agenda" targetRef="Task_RevisarDisponibilidad" associationDirection="One"/>
    <bpmn:association id="Association_CotizacionOut" sourceRef="Task_ElaborarCotizacion" targetRef="DataObjectRef_Cotizacion" associationDirection="One"/>
    <bpmn:association id="Association_CotizacionCom" sourceRef="DataObjectRef_Cotizacion" targetRef="Task_ComunicarCotizacion" associationDirection="One"/>
    <bpmn:association id="Association_RegistroEmitida" sourceRef="Task_RegistrarCotizacionEmitida" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
    <bpmn:association id="Association_RegistroAceptacion" sourceRef="Task_RegistrarAceptacion" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
    <bpmn:association id="Association_RegistroModificacion" sourceRef="Task_RegistrarModificacion" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
    <bpmn:association id="Association_RegistroRechazo" sourceRef="Task_RegistrarRechazo" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
    <bpmn:association id="Association_RegistroSinResp" sourceRef="Task_RegistrarSinRespuesta" targetRef="DataStoreRef_RegistroManual" associationDirection="One"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_ASIS" bpmnElement="Collaboration_ASIS">
      <bpmndi:BPMNShape id="Participant_Cliente_di" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="4100" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Funeraria_di" bpmnElement="Participant_Funeraria" isHorizontal="true">
        <dc:Bounds x="40" y="180" width="4100" height="840"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Atencion_di" bpmnElement="Lane_Atencion" isHorizontal="true">
        <dc:Bounds x="70" y="180" width="4070" height="410"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Administracion_di" bpmnElement="Lane_Administracion" isHorizontal="true">
        <dc:Bounds x="70" y="590" width="4070" height="430"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Solicitud_di" bpmnElement="StartEvent_Solicitud">
        <dc:Bounds x="120" y="300" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarSolicitud_di" bpmnElement="Task_RegistrarSolicitud">
        <dc:Bounds x="190" y="275" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecopilarDatos_di" bpmnElement="Task_RecopilarDatos">
        <dc:Bounds x="370" y="275" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DatosSuficientes_di" bpmnElement="Gateway_DatosSuficientes">
        <dc:Bounds x="560" y="290" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SolicitarDatos_di" bpmnElement="Task_SolicitarDatos">
        <dc:Bounds x="650" y="420" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EsperaDatos_di" bpmnElement="Gateway_EsperaDatos">
        <dc:Bounds x="840" y="435" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_DatosRecibidos_di" bpmnElement="Event_DatosRecibidos">
        <dc:Bounds x="950" y="417" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ActualizarDatos_di" bpmnElement="Task_ActualizarDatos">
        <dc:Bounds x="1030" y="395" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_TimeoutDatos_di" bpmnElement="Event_TimeoutDatos">
        <dc:Bounds x="950" y="497" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RegistrarPendiente_di" bpmnElement="Task_RegistrarPendiente">
        <dc:Bounds x="1030" y="475" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Incompleta_di" bpmnElement="EndEvent_Incompleta">
        <dc:Bounds x="1240" y="497" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_IdentificarServicios_di" bpmnElement="Task_IdentificarServicios">
        <dc:Bounds x="650" y="275" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultarTarifario_di" bpmnElement="Task_ConsultarTarifario">
        <dc:Bounds x="850" y="640" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevisarDisponibilidad_di" bpmnElement="Task_RevisarDisponibilidad">
        <dc:Bounds x="1040" y="640" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Disponibilidad_di" bpmnElement="Gateway_Disponibilidad">
        <dc:Bounds x="1240" y="655" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DefinirAlternativa_di" bpmnElement="Task_DefinirAlternativa">
        <dc:Bounds x="1340" y="770" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeDisponibilidad_di" bpmnElement="Gateway_MergeDisponibilidad">
        <dc:Bounds x="1540" y="655" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalcularImporte_di" bpmnElement="Task_CalcularImporte">
        <dc:Bounds x="1630" y="640" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ElaborarCotizacion_di" bpmnElement="Task_ElaborarCotizacion">
        <dc:Bounds x="1820" y="640" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerificarCotizacion_di" bpmnElement="Task_VerificarCotizacion">
        <dc:Bounds x="2010" y="640" width="150" height="80"/>
      </bpmndi:BPMNShape>
