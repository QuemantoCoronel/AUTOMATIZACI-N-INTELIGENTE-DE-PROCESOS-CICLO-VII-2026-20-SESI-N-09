<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_TO_BE_Funeraria" targetNamespace="http://funeraria-velazquex/to-be">
  <message id="Message_Solicitud" name="Solicitud digital de cotización"/>
  <message id="Message_DatosFaltantes" name="Solicitud de datos faltantes"/>
  <message id="Message_DatosCompletados" name="Datos completados"/>
  <message id="Message_Cotizacion" name="Cotización digital"/>
  <message id="Message_Aceptacion" name="Aceptación"/>
  <message id="Message_Modificacion" name="Solicitud de modificación"/>
  <message id="Message_Rechazo" name="Rechazo"/>
  <message id="Message_Recordatorio" name="Recordatorio"/>
  <dataStore id="DataStore_Central" name="Repositorio central de solicitudes y cotizaciones"/>
  <dataStore id="DataStore_Catalogo" name="Catálogo digital de servicios y precios"/>
  <dataStore id="DataStore_Disponibilidad" name="Disponibilidad de servicios"/>
  <process id="Process_Cliente" name="Cliente" isExecutable="false">
    <startEvent id="C_Start" name="Necesita cotización"/>
    <userTask id="C_Completar" name="Completar solicitud digital"/>
    <sendTask id="C_Enviar" name="Enviar solicitud"/>
    <eventBasedGateway id="C_Esperar" name="Esperar respuesta de la funeraria"/>
    <intermediateCatchEvent id="C_DatosFaltantes" name="Recibir solicitud de datos faltantes">
      <messageEventDefinition messageRef="Message_DatosFaltantes"/>
    </intermediateCatchEvent>
    <userTask id="C_CompletarDatos" name="Completar datos faltantes"/>
    <sendTask id="C_ReenviarDatos" name="Enviar datos completados"/>
    <intermediateCatchEvent id="C_RecibirCotizacion" name="Recibir cotización">
      <messageEventDefinition messageRef="Message_Cotizacion"/>
    </intermediateCatchEvent>
    <exclusiveGateway id="C_Decision" name="¿Qué decide el cliente?"/>
    <sendTask id="C_Aceptar" name="Aceptar cotización"/>
    <sendTask id="C_Modificar" name="Solicitar modificación"/>
    <sendTask id="C_Rechazar" name="Rechazar cotización"/>
    <endEvent id="C_FinAceptar" name="Cotización aceptada"/>
    <endEvent id="C_FinModificar" name="Modificación solicitada"/>
    <endEvent id="C_FinRechazar" name="Cotización rechazada"/>
    <sequenceFlow id="CF01" sourceRef="C_Start" targetRef="C_Completar"/>
    <sequenceFlow id="CF02" sourceRef="C_Completar" targetRef="C_Enviar"/>
    <sequenceFlow id="CF03" sourceRef="C_Enviar" targetRef="C_Esperar"/>
    <sequenceFlow id="CF04" sourceRef="C_Esperar" targetRef="C_DatosFaltantes"/>
    <sequenceFlow id="CF05" sourceRef="C_DatosFaltantes" targetRef="C_CompletarDatos"/>
    <sequenceFlow id="CF06" sourceRef="C_CompletarDatos" targetRef="C_ReenviarDatos"/>
    <sequenceFlow id="CF07" sourceRef="C_ReenviarDatos" targetRef="C_Esperar"/>
    <sequenceFlow id="CF08" sourceRef="C_Esperar" targetRef="C_RecibirCotizacion"/>
    <sequenceFlow id="CF09" sourceRef="C_RecibirCotizacion" targetRef="C_Decision"/>
    <sequenceFlow id="CF10" sourceRef="C_Decision" targetRef="C_Aceptar" name="Aceptar"/>
    <sequenceFlow id="CF11" sourceRef="C_Decision" targetRef="C_Modificar" name="Modificar"/>
    <sequenceFlow id="CF12" sourceRef="C_Decision" targetRef="C_Rechazar" name="Rechazar"/>
    <sequenceFlow id="CF13" sourceRef="C_Aceptar" targetRef="C_FinAceptar"/>
    <sequenceFlow id="CF14" sourceRef="C_Modificar" targetRef="C_FinModificar"/>
    <sequenceFlow id="CF15" sourceRef="C_Rechazar" targetRef="C_FinRechazar"/>
  </process>
  <process id="Process_Funeraria" name="Atender y registrar solicitudes de cotización de servicios funerarios - TO-BE" isExecutable="false">
    <laneSet id="LaneSet_Funeraria">
      <lane id="Lane_Atencion" name="Atención al cliente">
        <flowNodeRef>F_Start</flowNodeRef>
        <flowNodeRef>F_SolicitarDatos</flowNodeRef>
        <flowNodeRef>F_GW_EsperaDatos</flowNodeRef>
        <flowNodeRef>F_DatosRecibidos</flowNodeRef>
        <flowNodeRef>F_TimeoutDatos</flowNodeRef>
        <flowNodeRef>F_DefinirAlternativa</flowNodeRef>
        <flowNodeRef>F_RevisarCotizacion</flowNodeRef>
        <flowNodeRef>F_EnviarCotizacion</flowNodeRef>
        <flowNodeRef>F_GW_EsperaDecision</flowNodeRef>
        <flowNodeRef>F_Aceptacion</flowNodeRef>
        <flowNodeRef>F_Modificacion</flowNodeRef>
        <flowNodeRef>F_Rechazo</flowNodeRef>
        <flowNodeRef>F_TimeoutDecision</flowNodeRef>
        <flowNodeRef>F_RevisarModificacion</flowNodeRef>
        <flowNodeRef>F_Recordatorio</flowNodeRef>
        <flowNodeRef>F_GW_EsperaFinal</flowNodeRef>
        <flowNodeRef>F_Aceptacion2</flowNodeRef>
        <flowNodeRef>F_Modificacion2</flowNodeRef>
        <flowNodeRef>F_Rechazo2</flowNodeRef>
        <flowNodeRef>F_TimeoutFinal</flowNodeRef>
      </lane>
      <lane id="Lane_Administracion" name="Administración">
        <flowNodeRef>F_Registrar</flowNodeRef>
        <flowNodeRef>F_Validar</flowNodeRef>
        <flowNodeRef>F_GW_Datos</flowNodeRef>
        <flowNodeRef>F_Actualizar</flowNodeRef>
        <flowNodeRef>F_Incompleta</flowNodeRef>
        <flowNodeRef>F_FinIncompleta</flowNodeRef>
        <flowNodeRef>F_ConsultarCatalogo</flowNodeRef>
        <flowNodeRef>F_VerificarDisponibilidad</flowNodeRef>
        <flowNodeRef>F_GW_Disponible</flowNodeRef>
        <flowNodeRef>F_GW_UnirDisponibilidad</flowNodeRef>
        <flowNodeRef>F_GenerarCotizacion</flowNodeRef>
        <flowNodeRef>F_RegistrarEmision</flowNodeRef>
        <flowNodeRef>F_RegistrarAceptacion</flowNodeRef>
        <flowNodeRef>F_RegistrarRechazo</flowNodeRef>
        <flowNodeRef>F_RegistrarSinRespuesta</flowNodeRef>
        <flowNodeRef>F_GW_Cierre</flowNodeRef>
        <flowNodeRef>F_Archivar</flowNodeRef>
        <flowNodeRef>F_Fin</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="F_Start" name="Solicitud digital recibida">
      <messageEventDefinition messageRef="Message_Solicitud"/>
    </startEvent>
    <serviceTask id="F_Registrar" name="Registrar solicitud automáticamente"/>
    <serviceTask id="F_Validar" name="Validar información"/>
    <exclusiveGateway id="F_GW_Datos" name="¿Datos completos?"/>
    <sendTask id="F_SolicitarDatos" name="Solicitar datos faltantes"/>
    <eventBasedGateway id="F_GW_EsperaDatos" name="Esperar datos del cliente"/>
    <intermediateCatchEvent id="F_DatosRecibidos" name="Datos completados">
      <messageEventDefinition messageRef="Message_DatosCompletados"/>
    </intermediateCatchEvent>
    <serviceTask id="F_Actualizar" name="Actualizar solicitud"/>
    <intermediateCatchEvent id="F_TimeoutDatos" name="Plazo sin recibir datos">
      <timerEventDefinition>
        <timeDuration>P2D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="F_Incompleta" name="Registrar solicitud incompleta"/>
    <endEvent id="F_FinIncompleta" name="Solicitud incompleta"/>
    <serviceTask id="F_ConsultarCatalogo" name="Consultar servicios y precios"/>
    <serviceTask id="F_VerificarDisponibilidad" name="Verificar disponibilidad"/>
    <exclusiveGateway id="F_GW_Disponible" name="¿Servicio disponible?"/>
    <userTask id="F_DefinirAlternativa" name="Definir alternativa"/>
    <exclusiveGateway id="F_GW_UnirDisponibilidad" name="Unir disponibilidad"/>
    <serviceTask id="F_GenerarCotizacion" name="Generar cotización"/>
    <userTask id="F_RevisarCotizacion" name="Revisar cotización"/>
    <sendTask id="F_EnviarCotizacion" name="Enviar cotización al cliente"/>
    <serviceTask id="F_RegistrarEmision" name="Registrar emisión y programar seguimiento"/>
    <eventBasedGateway id="F_GW_EsperaDecision" name="Esperar decisión del cliente"/>
    <intermediateCatchEvent id="F_Aceptacion" name="Aceptación recibida">
      <messageEventDefinition messageRef="Message_Aceptacion"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="F_Modificacion" name="Modificación recibida">
      <messageEventDefinition messageRef="Message_Modificacion"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="F_Rechazo" name="Rechazo recibido">
      <messageEventDefinition messageRef="Message_Rechazo"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="F_TimeoutDecision" name="Plazo de seguimiento vencido">
      <timerEventDefinition>
        <timeDuration>P2D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="F_RegistrarAceptacion" name="Registrar aceptación"/>
    <userTask id="F_RevisarModificacion" name="Revisar cambios solicitados"/>
    <serviceTask id="F_RegistrarRechazo" name="Registrar rechazo"/>
    <sendTask id="F_Recordatorio" name="Enviar recordatorio"/>
    <eventBasedGateway id="F_GW_EsperaFinal" name="Esperar respuesta final"/>
    <intermediateCatchEvent id="F_Aceptacion2" name="Aceptación recibida">
      <messageEventDefinition messageRef="Message_Aceptacion"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="F_Modificacion2" name="Modificación recibida">
      <messageEventDefinition messageRef="Message_Modificacion"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="F_Rechazo2" name="Rechazo recibido">
      <messageEventDefinition messageRef="Message_Rechazo"/>
    </intermediateCatchEvent>
    <intermediateCatchEvent id="F_TimeoutFinal" name="Sin respuesta">
      <timerEventDefinition>
        <timeDuration>P2D</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="F_RegistrarSinRespuesta" name="Registrar sin respuesta"/>
    <exclusiveGateway id="F_GW_Cierre" name="Unir cierre"/>
    <serviceTask id="F_Archivar" name="Archivar solicitud"/>
    <endEvent id="F_Fin" name="Solicitud cerrada"/>
    <sequenceFlow id="F01" sourceRef="F_Start" targetRef="F_Registrar"/>
    <sequenceFlow id="F02" sourceRef="F_Registrar" targetRef="F_Validar"/>
    <sequenceFlow id="F03" sourceRef="F_Validar" targetRef="F_GW_Datos"/>
    <sequenceFlow id="F04" sourceRef="F_GW_Datos" targetRef="F_ConsultarCatalogo" name="Sí"/>
    <sequenceFlow id="F05" sourceRef="F_GW_Datos" targetRef="F_SolicitarDatos" name="No"/>
    <sequenceFlow id="F06" sourceRef="F_SolicitarDatos" targetRef="F_GW_EsperaDatos"/>
    <sequenceFlow id="F07" sourceRef="F_GW_EsperaDatos" targetRef="F_DatosRecibidos"/>
    <sequenceFlow id="F08" sourceRef="F_DatosRecibidos" targetRef="F_Actualizar"/>
    <sequenceFlow id="F09" sourceRef="F_Actualizar" targetRef="F_Validar"/>
    <sequenceFlow id="F10" sourceRef="F_GW_EsperaDatos" targetRef="F_TimeoutDatos"/>
    <sequenceFlow id="F11" sourceRef="F_TimeoutDatos" targetRef="F_Incompleta"/>
    <sequenceFlow id="F12" sourceRef="F_Incompleta" targetRef="F_FinIncompleta"/>
    <sequenceFlow id="F13" sourceRef="F_ConsultarCatalogo" targetRef="F_VerificarDisponibilidad"/>
    <sequenceFlow id="F14" sourceRef="F_VerificarDisponibilidad" targetRef="F_GW_Disponible"/>
    <sequenceFlow id="F15" sourceRef="F_GW_Disponible" targetRef="F_GW_UnirDisponibilidad" name="Sí"/>
    <sequenceFlow id="F16" sourceRef="F_GW_Disponible" targetRef="F_DefinirAlternativa" name="No"/>
    <sequenceFlow id="F17" sourceRef="F_DefinirAlternativa" targetRef="F_GW_UnirDisponibilidad"/>
    <sequenceFlow id="F18" sourceRef="F_GW_UnirDisponibilidad" targetRef="F_GenerarCotizacion"/>
    <sequenceFlow id="F19" sourceRef="F_GenerarCotizacion" targetRef="F_RevisarCotizacion"/>
    <sequenceFlow id="F20" sourceRef="F_RevisarCotizacion" targetRef="F_EnviarCotizacion"/>
    <sequenceFlow id="F21" sourceRef="F_EnviarCotizacion" targetRef="F_RegistrarEmision"/>
    <sequenceFlow id="F22" sourceRef="F_RegistrarEmision" targetRef="F_GW_EsperaDecision"/>
    <sequenceFlow id="F23" sourceRef="F_GW_EsperaDecision" targetRef="F_Aceptacion"/>
    <sequenceFlow id="F24" sourceRef="F_Aceptacion" targetRef="F_RegistrarAceptacion"/>
    <sequenceFlow id="F25" sourceRef="F_RegistrarAceptacion" targetRef="F_GW_Cierre"/>
    <sequenceFlow id="F26" sourceRef="F_GW_EsperaDecision" targetRef="F_Modificacion"/>
    <sequenceFlow id="F27" sourceRef="F_Modificacion" targetRef="F_RevisarModificacion"/>
    <sequenceFlow id="F28" sourceRef="F_RevisarModificacion" targetRef="F_ConsultarCatalogo"/>
    <sequenceFlow id="F29" sourceRef="F_GW_EsperaDecision" targetRef="F_Rechazo"/>
    <sequenceFlow id="F30" sourceRef="F_Rechazo" targetRef="F_RegistrarRechazo"/>
    <sequenceFlow id="F31" sourceRef="F_RegistrarRechazo" targetRef="F_GW_Cierre"/>
    <sequenceFlow id="F32" sourceRef="F_GW_EsperaDecision" targetRef="F_TimeoutDecision"/>
    <sequenceFlow id="F33" sourceRef="F_TimeoutDecision" targetRef="F_Recordatorio"/>
    <sequenceFlow id="F34" sourceRef="F_Recordatorio" targetRef="F_GW_EsperaFinal"/>
    <sequenceFlow id="F35" sourceRef="F_GW_EsperaFinal" targetRef="F_Aceptacion2"/>
    <sequenceFlow id="F36" sourceRef="F_Aceptacion2" targetRef="F_RegistrarAceptacion"/>
    <sequenceFlow id="F37" sourceRef="F_GW_EsperaFinal" targetRef="F_Modificacion2"/>
    <sequenceFlow id="F38" sourceRef="F_Modificacion2" targetRef="F_RevisarModificacion"/>
    <sequenceFlow id="F39" sourceRef="F_GW_EsperaFinal" targetRef="F_Rechazo2"/>
    <sequenceFlow id="F40" sourceRef="F_Rechazo2" targetRef="F_RegistrarRechazo"/>
    <sequenceFlow id="F41" sourceRef="F_GW_EsperaFinal" targetRef="F_TimeoutFinal"/>
    <sequenceFlow id="F42" sourceRef="F_TimeoutFinal" targetRef="F_RegistrarSinRespuesta"/>
    <sequenceFlow id="F43" sourceRef="F_RegistrarSinRespuesta" targetRef="F_GW_Cierre"/>
    <sequenceFlow id="F44" sourceRef="F_GW_Cierre" targetRef="F_Archivar"/>
    <sequenceFlow id="F45" sourceRef="F_Archivar" targetRef="F_Fin"/>
    <dataStoreReference id="DS_Central" name="Repositorio central" dataStoreRef="DataStore_Central"/>
    <dataStoreReference id="DS_Catalogo" name="Catálogo digital" dataStoreRef="DataStore_Catalogo"/>
    <dataStoreReference id="DS_Disponibilidad" name="Disponibilidad" dataStoreRef="DataStore_Disponibilidad"/>
    <association id="A01" sourceRef="F_Registrar" targetRef="DS_Central"/>
    <association id="A02" sourceRef="F_Actualizar" targetRef="DS_Central"/>
    <association id="A03" sourceRef="F_ConsultarCatalogo" targetRef="DS_Catalogo"/>
    <association id="A04" sourceRef="F_VerificarDisponibilidad" targetRef="DS_Disponibilidad"/>
    <association id="A05" sourceRef="F_GenerarCotizacion" targetRef="DS_Central"/>
    <association id="A06" sourceRef="F_RegistrarEmision" targetRef="DS_Central"/>
    <association id="A07" sourceRef="F_RegistrarAceptacion" targetRef="DS_Central"/>
    <association id="A08" sourceRef="F_RegistrarRechazo" targetRef="DS_Central"/>
    <association id="A09" sourceRef="F_RegistrarSinRespuesta" targetRef="DS_Central"/>
    <textAnnotation id="Annotation_Alcance">
      <text>Alcance TO-BE: desde la solicitud digital de cotización hasta su registro y cierre. Contratación, pago y ejecución del servicio funerario permanecen fuera de alcance.</text>
    </textAnnotation>
    <association id="A10" sourceRef="F_GenerarCotizacion" targetRef="Annotation_Alcance"/>
  </process>
  <collaboration id="Collaboration_TO_BE">
    <participant id="Participant_Cliente" name="Cliente" processRef="Process_Cliente"/>
    <participant id="Participant_Funeraria" name="Funeraria Velazquex" processRef="Process_Funeraria"/>
    <messageFlow id="MF01" sourceRef="C_Enviar" targetRef="F_Start" name="Solicitud digital" messageRef="Message_Solicitud"/>
    <messageFlow id="MF02" sourceRef="F_SolicitarDatos" targetRef="C_DatosFaltantes" name="Datos faltantes" messageRef="Message_DatosFaltantes"/>
    <messageFlow id="MF03" sourceRef="C_ReenviarDatos" targetRef="F_DatosRecibidos" name="Datos completados" messageRef="Message_DatosCompletados"/>
    <messageFlow id="MF04" sourceRef="F_EnviarCotizacion" targetRef="C_RecibirCotizacion" name="Cotización" messageRef="Message_Cotizacion"/>
    <messageFlow id="MF05" sourceRef="C_Aceptar" targetRef="F_Aceptacion" name="Aceptación" messageRef="Message_Aceptacion"/>
    <messageFlow id="MF06" sourceRef="C_Modificar" targetRef="F_Modificacion" name="Modificación" messageRef="Message_Modificacion"/>
    <messageFlow id="MF07" sourceRef="C_Rechazar" targetRef="F_Rechazo" name="Rechazo" messageRef="Message_Rechazo"/>
    <messageFlow id="MF08" sourceRef="F_Recordatorio" targetRef="C_RecibirCotizacion" name="Recordatorio" messageRef="Message_Recordatorio"/>
    <messageFlow id="MF09" sourceRef="C_Aceptar" targetRef="F_Aceptacion2" name="Aceptación final" messageRef="Message_Aceptacion"/>
    <messageFlow id="MF10" sourceRef="C_Modificar" targetRef="F_Modificacion2" name="Modificación final" messageRef="Message_Modificacion"/>
    <messageFlow id="MF11" sourceRef="C_Rechazar" targetRef="F_Rechazo2" name="Rechazo final" messageRef="Message_Rechazo"/>
  </collaboration>
  <bpmndi:BPMNDiagram id="Diagram_TO_BE">
    <bpmndi:BPMNPlane id="Plane_TO_BE" bpmnElement="Collaboration_TO_BE">
      <bpmndi:BPMNShape id="Shape_Participant_Cliente" bpmnElement="Participant_Cliente" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="4300" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Funeraria" bpmnElement="Participant_Funeraria" isHorizontal="true">
        <dc:Bounds x="40" y="380" width="4300" height="1000"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Atencion" bpmnElement="Lane_Atencion" isHorizontal="true">
        <dc:Bounds x="70" y="380" width="4270" height="430"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Administracion" bpmnElement="Lane_Administracion" isHorizontal="true">
        <dc:Bounds x="70" y="810" width="4270" height="570"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_Start" bpmnElement="C_Start">
