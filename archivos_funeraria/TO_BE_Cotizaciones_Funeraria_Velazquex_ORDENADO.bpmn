      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_Completar" bpmnElement="C_Completar">
        <dc:Bounds x="210" y="145" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_Enviar" bpmnElement="C_Enviar">
