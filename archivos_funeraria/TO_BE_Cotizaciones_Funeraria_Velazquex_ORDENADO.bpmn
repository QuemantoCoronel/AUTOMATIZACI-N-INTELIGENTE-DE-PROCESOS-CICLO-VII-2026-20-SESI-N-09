      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_CompletarDatos" bpmnElement="C_CompletarDatos">
        <dc:Bounds x="1050" y="70" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_ReenviarDatos" bpmnElement="C_ReenviarDatos">
