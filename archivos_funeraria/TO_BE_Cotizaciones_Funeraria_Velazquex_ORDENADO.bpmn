        <dc:Bounds x="2610" y="70" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_Modificar" bpmnElement="C_Modificar">
        <dc:Bounds x="2610" y="155" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_Rechazar" bpmnElement="C_Rechazar">
        <dc:Bounds x="2610" y="240" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_FinAceptar" bpmnElement="C_FinAceptar">
        <dc:Bounds x="2840" y="92" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_FinModificar" bpmnElement="C_FinModificar">
        <dc:Bounds x="2840" y="177" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_C_FinRechazar" bpmnElement="C_FinRechazar">
        <dc:Bounds x="2840" y="262" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_Start" bpmnElement="F_Start">
        <dc:Bounds x="487" y="560" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_Registrar" bpmnElement="F_Registrar">
        <dc:Bounds x="540" y="890" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_Validar" bpmnElement="F_Validar">
        <dc:Bounds x="740" y="890" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_GW_Datos" bpmnElement="F_GW_Datos">
        <dc:Bounds x="940" y="905" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_SolicitarDatos" bpmnElement="F_SolicitarDatos">
        <dc:Bounds x="1060" y="475" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_GW_EsperaDatos" bpmnElement="F_GW_EsperaDatos">
        <dc:Bounds x="1270" y="490" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_DatosRecibidos" bpmnElement="F_DatosRecibidos">
        <dc:Bounds x="1430" y="445" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_Actualizar" bpmnElement="F_Actualizar">
        <dc:Bounds x="1510" y="865" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_F_TimeoutDatos" bpmnElement="F_TimeoutDatos">
