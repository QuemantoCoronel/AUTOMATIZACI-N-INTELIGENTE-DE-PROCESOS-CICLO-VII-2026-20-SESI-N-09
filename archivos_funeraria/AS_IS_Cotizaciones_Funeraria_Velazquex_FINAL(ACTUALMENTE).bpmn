        <dc:Bounds x="1210" y="820" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1195" y="870" width="67" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStoreRef_RegistroManual_di" bpmnElement="DataStoreRef_RegistroManual">
        <dc:Bounds x="3770" y="850" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3754" y="812.5" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConsultarTarifario_di" bpmnElement="Task_ConsultarTarifario">
        <dc:Bounds x="1035" y="650" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectRef_Tarifario_di" bpmnElement="DataObjectRef_Tarifario">
        <dc:Bounds x="1085" y="830" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1062" y="880" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RevisarDisponibilidad_di" bpmnElement="Task_RevisarDisponibilidad">
