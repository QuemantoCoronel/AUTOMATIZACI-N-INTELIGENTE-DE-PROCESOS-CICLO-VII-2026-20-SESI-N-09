        <bpmndi:BPMNLabel>
          <dc:Bounds x="1337" y="533" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_MergeDisponibilidad_di" bpmnElement="Gateway_MergeDisponibilidad" isMarkerVisible="true">
        <dc:Bounds x="1660" y="655" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1650" y="617.5" width="69" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
